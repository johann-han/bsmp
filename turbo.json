{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "AI_PROVIDER",
    "OPENAI_API_KEY",
    "OPENAI_MODEL",
    "OPENAI_APPLICATION_MODEL",
    "OPENAI_BIBLICAL_THEOLOGY_MODEL",
    "OPENAI_TEACHING_MODEL",
    "OPENAI_FINAL_SERMON_DRAFT_MODEL",
    "OPENAI_SERMON_DELIVERY_MODEL",
    "OPENAI_SERMON_EXPOSITION_MODEL",
    "OPENAI_RESEARCH_MODEL",
    "GEMINI_API_KEY",
    "GEMINI_MODEL",
    "GEMINI_APPLICATION_MODEL",
    "GEMINI_BIBLICAL_THEOLOGY_MODEL",
    "GEMINI_INTERPRETATION_MODEL",
    "GEMINI_TEACHING_MODEL",
    "GEMINI_FINAL_SERMON_DRAFT_MODEL",
    "GEMINI_SERMON_DELIVERY_MODEL",
    "GEMINI_SERMON_EXPOSITION_MODEL",
    "GEMINI_RESEARCH_MODEL",
    "OPENROUTER_API_KEY",
    "OPENROUTER_RESEARCH_MODEL",
    "OPENROUTER_SITE_URL",
    "OPENROUTER_APP_NAME",
    "SUPABASE_SERVICE_ROLE_KEY",
    "BILLING_PROVIDER",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_WEBHOOK_TOLERANCE_SECONDS",
    "STRIPE_PRICE_MAP",
    "PAYFAST_MERCHANT_ID",
    "PAYFAST_MERCHANT_KEY",
    "PAYFAST_PASSPHRASE",
    "PAYFAST_SANDBOX",
    "PAYFAST_PLAN_MAP",
    "PAYFAST_ITN_ALLOWED_IPS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
