NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only Supabase service role key used for AI usage metering. Never expose as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-server-side-service-role-key

# AI mentor provider: gemini (development default) or openai
AI_PROVIDER=gemini

# Gemini development provider
GEMINI_API_KEY=your-server-side-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# OpenAI alternative provider
OPENAI_API_KEY=your-server-side-openai-api-key
OPENAI_MODEL=gpt-5.6-luna

# Reserved for the future payment/subscription provider adapter. Leave unset until a provider is connected.
# BILLING_PROVIDER=your-provider-id

# Stripe provider adapter (leave unset until Stripe is connected)
# BILLING_PROVIDER=stripe
# STRIPE_SECRET_KEY=your-server-side-stripe-secret-key
# STRIPE_WEBHOOK_SECRET=your-server-side-stripe-webhook-signing-secret
# Each active BSMP plan needs a matching Stripe recurring Price id:
# STRIPE_PRICE_<PLAN_CODE_IN_UPPERCASE>=price_xxx
# Example plan code `starter-monthly` -> STRIPE_PRICE_STARTER_MONTHLY=price_xxx
# STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
