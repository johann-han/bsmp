NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only Supabase service role key used for AI usage metering. Never expose as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-server-side-service-role-key

# AI mentor provider: gemini (development default) or openai
AI_PROVIDER=gemini

# Gemini development provider
GEMINI_API_KEY=your-server-side-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# OpenAI alternative provider
OPENAI_API_KEY=your-server-side-openai-api-key
OPENAI_MODEL=gpt-5.6-luna

# Billing provider
# PAYFAST is the configured target provider for BSMP. Leave unset until credentials and sandbox settings are added.
# BILLING_PROVIDER=payfast

# PayFast merchant credentials and recurring-plan configuration (server-only)
# PAYFAST_MERCHANT_ID=your-payfast-merchant-id
# PAYFAST_MERCHANT_KEY=your-payfast-merchant-key
# PAYFAST_PASSPHRASE=your-payfast-salt-passphrase
# PAYFAST_SANDBOX=true
# PUBLIC_APP_URL=https://your-public-bsmp-domain
# PAYFAST_PLAN_CONFIG={"starter-monthly":{"amount":99.00,"recurringAmount":99.00,"frequency":3,"cycles":0,"itemName":"BSMP Starter","itemDescription":"BSMP Starter monthly subscription"}}
# PAYFAST_ITN_ALLOWED_IPS=197.97.145.144/28,41.74.179.192/27,102.216.36.0/28,102.216.36.128/28,144.126.193.139


# Optional Stripe provider adapter (not required for BSMP PayFast billing)
# BILLING_PROVIDER=stripe
# STRIPE_SECRET_KEY=your-server-side-stripe-secret-key
# STRIPE_WEBHOOK_SECRET=your-server-side-stripe-webhook-signing-secret
# Stripe recurring Price ids keyed by stable BSMP plan code:
# STRIPE_PRICE_MAP={"starter-monthly":"price_xxx"}
# STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
