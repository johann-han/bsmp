NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only Supabase service role key used for AI usage metering. Never expose as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-server-side-service-role-key

# AI mentor provider: gemini (development default) or openai
AI_PROVIDER=gemini

# Gemini development provider
GEMINI_API_KEY=your-server-side-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# OpenAI alternative provider
OPENAI_API_KEY=your-server-side-openai-api-key
OPENAI_MODEL=gpt-5.6-luna

# Payment/subscription provider
BILLING_PROVIDER=payfast

# PayFast environment: true for Sandbox, false/unset for live
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=your-payfast-merchant-id
PAYFAST_MERCHANT_KEY=your-payfast-merchant-key
# Required for PayFast subscriptions
PAYFAST_PASSPHRASE=your-payfast-passphrase
# Public HTTPS URL used for PayFast return/cancel/ITN callbacks.
PUBLIC_APP_URL=https://your-public-domain.example
# PayFast subscription configuration keyed by stable BSMP plan code.
# amount = initial charge; recurringAmount = future recurring charge in ZAR.
# frequency: 1 daily, 2 weekly, 3 monthly, 4 quarterly, 5 biannually, 6 annually.
# cycles: 0 = indefinite, 1-9 = finite cycles.
PAYFAST_PLAN_CONFIG={"starter-monthly":{"amount":99.00,"recurringAmount":99.00,"frequency":3,"cycles":0}}
# Configure the current PayFast ITN source ranges/IPs used by your deployment.
# Current published PayFast IPv4 ranges include:
# 197.97.145.144/28, 41.74.179.192/27, 102.216.36.0/28, 102.216.36.128/28, 144.126.193.139
PAYFAST_ITN_ALLOWED_IPS=197.97.145.144/28,41.74.179.192/27,102.216.36.0/28,102.216.36.128/28,144.126.193.139
